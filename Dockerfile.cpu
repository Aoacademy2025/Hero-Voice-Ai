# Hero Voice TTS API — CPU-only image (สำหรับ VPS ไม่มี GPU เช่น Hostinger)
FROM python:3.10-slim

# libsndfile จำเป็นสำหรับ soundfile, ffmpeg สำหรับ pydub/librosa
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsndfile1 ffmpeg git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1) ติดตั้ง torch แบบ CPU-only ก่อน (เบากว่ามาก ไม่ต้องดึง CUDA wheels)
#    ล็อกเวอร์ชัน torch/torchaudio ให้ตรงกันชัดเจน (2.5.x คู่กัน) — ถ้าไม่ระบุ
#    ตายตัว pip อาจ resolve torchaudio เป็นเวอร์ชันที่ ABI ไม่ตรงกับ torch
#    (เจอ error "undefined symbol: aoti_torch_abi_version")
RUN pip install --no-cache-dir torch==2.5.1 torchaudio==2.5.1 \
        --index-url https://download.pytorch.org/whl/cpu

# 2) ติดตั้ง deps อื่นของ API
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 3) ติดตั้งแพ็กเกจ omnivoice จากซอร์สในโปรเจกต์
#    --no-deps: omnivoice ประกาศ torch/torchaudio เป็น dependency ด้วย ถ้าไม่กัน
#    pip จะไปติดตั้งทับตัว CPU wheel ที่ล็อกไว้ในขั้นตอน 1 (ABI ไม่ตรงกัน)
COPY OmniVoice/ /app/OmniVoice/
RUN pip install --no-cache-dir --no-deps /app/OmniVoice \
    && pip install --no-cache-dir \
        accelerate pydub tensorboardX webdataset numpy soundfile librosa

# 4) โค้ด server + สคริปต์ — ก็อปทั้งโฟลเดอร์ทับซ้อนโครงสร้างเดียวกับ host (ดูคอมเมนต์ใน Dockerfile หลัก)
COPY core/ /app/core/
COPY scripts/ /app/scripts/
COPY data/ /app/data/
COPY model/ /app/model/
COPY voices/ /app/voices/

ENV TTS_MODEL_DIR=/app/model \
    TTS_VOICES_DIR=/app/voices \
    TTS_MAX_CONCURRENCY=1 \
    TTS_CORS_ORIGINS=*
# หมายเหตุ: ตั้ง TTS_API_KEY หรือ TTS_CREDITS_DB ตอน run (อย่า bake key ลง image)

EXPOSE 8000

# CPU-only + 2 vCPU -> generate ทีละงาน (MAX_CONCURRENCY=1) กันแย่ง CPU จนช้าลงอีก
CMD ["python", "core/server.py"]
